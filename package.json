{
  "name": "open-channel",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "sdk/typescript",
    "server",
    "match",
    "examples/chat",
    "examples/walk",
    "examples/tasks",
    "examples/notes",
    "examples/console"
  ],
  "scripts": {
    "test": "tsx --test test/**/*.test.ts server/test/**/*.test.ts sdk/typescript/test/**/*.test.ts match/test/**/*.test.ts examples/console/test/**/*.test.ts examples/walk/test/**/*.test.ts examples/hub/test/**/*.test.ts",
    "test:python": "python3 -m unittest discover -s sdk/python/tests",
    "test:e2e": "node e2e/console.mjs && node e2e/surfaces.mjs && node e2e/hub.mjs",
    "dev:chat": "tsx examples/chat/index.ts",
    "dev:tasks": "tsx examples/tasks/index.ts",
    "dev:notes": "tsx examples/notes/index.ts",
    "dev:native": "tsx examples/native/index.ts",
    "dev:walk": "tsx examples/walk/index.ts",
    "dev:console": "tsx examples/console/index.ts",
    "dev:hub": "tsx examples/hub/index.ts",
    "dev": "node scripts/dev-all.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
